# Keys of the claw2 gateway. Copy it to claw2.env next to this file and
# fill in. Root may read it, nobody else needs to: the service reads it
# before dropping to its user and hands the values to the gateway in the
# environment. Plain KEY=value lines; quote a value with spaces.

# The model provider key.
OPENAI_API_KEY=

# The key of the gateway itself — the web interface asks for it.
# Generate one:  openssl rand -hex 24
CLAW2_GATEWAY_API_KEY=
